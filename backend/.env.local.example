# Copy this file to .env.local and fill in actual values
# DO NOT commit .env.local to version control

# Google OAuth2
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# MongoDB (if using local instance instead of Atlas)
# MONGO_URI=mongodb://localhost:27017/pafDB

# JWT Secret (optional - defaults to application.properties)
# APP_JWT_SECRET=your_jwt_secret_here

# Frontend URL
# APP_FRONTEND_URL=http://localhost:5173
